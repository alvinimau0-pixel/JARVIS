{
  "name": "jarvis-os",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "contracts:export": "cd backend && uv run python scripts/export_contracts.py",
    "contracts:gen": "pnpm contracts:export && pnpm --filter @jarvis/contracts gen",
